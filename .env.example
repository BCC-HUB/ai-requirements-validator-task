# Пример конфигурации агента проверки требований.
# Скопируйте этот файл в .env (cp .env.example .env) и укажите ключ выбранного провайдера LLM.
# ВНИМАНИЕ: файл .env с реальными ключами не коммитится (он в .gitignore).

# Какой провайдер использовать: gemini | anthropic | openrouter | deepseek | openai | ollama | claude-cli.
# Если не задан, агент выберет провайдер по первому найденному ключу:
# Gemini → Anthropic (Claude) → OpenRouter → DeepSeek → OpenAI → Ollama.
# Модели указывать не обязательно: у каждого провайдера есть модель по умолчанию.
LLM_PROVIDER=gemini

# --- Google Gemini API (рекомендуемый бесплатный вариант: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Алиас на актуальную модель Flash. Можно указать конкретную версию, например gemini-2.5-flash.
# Список доступных вашему ключу моделей: python -m reqvalidator --list-models
GEMINI_MODEL=gemini-flash-latest
# Резервные модели (через запятую): используются, если основная перегружена (503),
# недоступна новым ключам (404) или исчерпала дневную квоту.
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest

# --- Anthropic Claude API (https://platform.claude.com/settings/keys), нужен пакет: pip install anthropic ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here   # можно и под именем CLAUDE_API_KEY
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high

# --- OpenRouter: один ключ к Claude, Gemini, DeepSeek, GPT (https://openrouter.ai/keys) ---
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_EFFORT=high

# --- DeepSeek API (https://platform.deepseek.com/api_keys) ---
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI или любой OpenAI-совместимый сервер (vLLM, LM Studio, OpenRouter и т. п.) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Локальная модель через Ollama (ключ не нужен) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_NUM_CTX=32768

# --- Claude Code CLI (claude -p) — использует выполненный вход в Claude Code, ключ не нужен ---
# CLAUDE_CLI_MODEL=claude-opus-5-5
# CLAUDE_CLI_EFFORT=high
# CLAUDE_CLI_PATH=claude

# --- Общие параметры (необязательно) ---
# LLM_TEMPERATURE=            # пусто — значение по умолчанию у провайдера
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_TIMEOUT=300             # секунд на один запрос
# LLM_MAX_RETRIES=5           # повторы при 429/5xx/обрыве сети
# LLM_MIN_INTERVAL=4          # пауза между запросами, сек (для бесплатных тарифов)
# LLM_CONCURRENCY=1           # параллельных запросов
# REQVALIDATOR_BATCH_SIZE=6   # требований в одном запросе на проверку
# REQVALIDATOR_REVIEW=1       # 1 — этап самопроверки замечаний включён, 0 — выключен
# REQVALIDATOR_CACHE_DIR=.reqvalidator_cache   # пусто — кэш ответов модели выключен
