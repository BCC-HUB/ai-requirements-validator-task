# Пример конфигурации агента проверки требований.
# Скопируйте этот файл в .env (cp .env.example .env) и впишите ОДИН ключ — этого достаточно.
# Модель указывать не обязательно: у каждого провайдера есть модель по умолчанию.
# ВНИМАНИЕ: файл .env с реальными ключами не коммитится (он в .gitignore).

# Провайдер выбирается автоматически по первому найденному ключу:
# Claude → OpenRouter → Gemini → DeepSeek → OpenAI → Ollama.
# Явный выбор: gemini | anthropic | openrouter | deepseek | openai | ollama | claude-cli
# LLM_PROVIDER=anthropic

# --- Рекомендуется: Claude Opus 5.5 через Anthropic API (https://platform.claude.com/settings/keys) ---
# Можно назвать переменную и ANTHROPIC_API_KEY.
CLAUDE_API_KEY=your_claude_api_key_here
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high          # глубина рассуждений: low | medium | high | xhigh | max

# --- Бесплатный вариант: Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-flash-latest
# Резервные модели (через запятую): используются, если основная перегружена (503),
# недоступна новым ключам (404) или исчерпала дневную квоту.
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest

# --- OpenRouter: один ключ к Claude, Gemini, DeepSeek, GPT (https://openrouter.ai/keys) ---
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_EFFORT=high

# --- DeepSeek API (https://platform.deepseek.com/api_keys) ---
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-pro      # или deepseek-flash (дешевле)

# --- OpenAI или любой OpenAI-совместимый сервер (vLLM, LM Studio и т. п.) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Локальная модель через Ollama (ключ не нужен; https://ollama.com) ---
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=32768

# --- Claude Code CLI (claude -p) — использует вход в Claude Code, ключ не нужен ---
# CLAUDE_CLI_MODEL=claude-opus-5-5
# CLAUDE_CLI_EFFORT=high
# CLAUDE_CLI_PATH=claude

# --- Общие параметры (необязательно) ---
# LLM_TEMPERATURE=            # пусто — значение по умолчанию у провайдера (у Claude не используется)
# LLM_MAX_OUTPUT_TOKENS=32000
# LLM_TIMEOUT=600             # секунд на один запрос
# LLM_MAX_RETRIES=6           # повторы при 429/5xx/обрыве сети (пауза 3 → 90 с)
# LLM_MIN_INTERVAL=0          # пауза между запросами, сек (для Gemini по умолчанию 4)
# LLM_CONCURRENCY=4           # параллельных запросов (для Gemini по умолчанию 1)
# REQVALIDATOR_BATCH_SIZE=6   # требований в одном запросе на проверку
# REQVALIDATOR_REVIEW=1       # 1 — этап самопроверки замечаний включён, 0 — выключен
# REQVALIDATOR_CACHE_DIR=.reqvalidator_cache   # пусто — кэш ответов модели выключен
